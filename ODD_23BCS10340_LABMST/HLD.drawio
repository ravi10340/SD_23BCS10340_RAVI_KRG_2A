        <mxCell id="2np1FAwL-6DYAeNSwEZt-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=1;labelBackgroundColor=none;fontColor=#FEFAE0;" value="Design an Instagram like System with following requirements :&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="650" x="-120" y="70" as="geometry" />
        </mxCell>
        <mxCell id="2np1FAwL-6DYAeNSwEZt-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=1;labelBackgroundColor=none;fontColor=#FEFAE0;" value="Implement a mechanism to restrict the user for posting a non policy cimpliant post.&lt;div&gt;Optimize the dynamic feed generation for the users.&lt;br&gt;Highlight the use of back fill service.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="800" x="-140" y="260" as="geometry" />
        </mxCell>
        <mxCell id="2np1FAwL-6DYAeNSwEZt-11" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;labelBackgroundColor=none;fontColor=#FEFAE0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Functional requirements :&lt;/h1&gt;&lt;p&gt;1. User should be able to login Signup .&lt;br&gt;2. User should be able to follow firends .&lt;br&gt;3. User should be able to post Content.&lt;br&gt;4. User should be able to engage with service like (posting , like comment )&lt;/p&gt;&lt;p&gt;5. User should have its feed on basis of friends and individual interest .&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="410" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="2np1FAwL-6DYAeNSwEZt-6" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;rounded=1;labelBackgroundColor=none;fontColor=#FEFAE0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
